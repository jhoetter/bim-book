# OpenAI API Key für Bildgenerierung (DALL-E 3)
# Eigenen Key eintragen: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: Modell überschreiben (Standard: dall-e-3)
# OPENAI_IMAGE_MODEL=dall-e-3

# Optional: Bildgröße (Standard: 1792x1024 für Querformat)
# OPENAI_IMAGE_SIZE=1792x1024

# Anthropic API Key für den BIM-Assistenten (Chatbot + MCP)
# Eigenen Key eintragen: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key für Veo-Videogenerierung
# Eigenen Key eintragen: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# Optional: Veo-Modell überschreiben
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Optional: günstiges Gemini-Modell für Hybrid-Storyboard/Planung
# GEMINI_PLANNER_MODEL=gemini-2.5-flash-lite

# Optional: lokale macOS-Stimme für Hybrid-Rendering ohne API-Kosten
# HYBRID_TTS_VOICE=Anna

# Optional: TTS für Hybrid-Videos: auto | gemini | local | silent
# HYBRID_TTS_PROVIDER=auto
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Charon

# Optional: Gemini-Modell für Video-Review / Qualitätsloop
# GEMINI_REVIEW_MODEL=gemini-2.5-flash
